{
  "name": "notes-intel",
  "version": "4.6.4",
  "description": "Notes Intel — QA assistant desktop app.",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "author": "Tactile Entertainment",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "latest"
  },
  "build": {
    "appId": "com.tactilegames.notesintel",
    "productName": "Notes Intel",
    "directories": {
      "output": "dist",
      "buildResources": "electron-resources"
    },
    "files": [
      "electron/**/*",
      "app/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "signAndEditExecutable": false,
      "icon": "electron-resources/icon.ico",
      "target": ["nsis"]
    },
    "mac": {
      "icon": "electron-resources/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [{ "target": "dmg", "arch": "universal" }]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "electron-resources/icon.ico",
      "uninstallerIcon": "electron-resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "hema1584",
      "repo": "notes-intel"
    }
  }
}
